# Copy to .env and replace every placeholder with your own values.

APP_NAME=Lavalust
APP_KEY=replace-with-a-long-random-application-key
APP_ENV=development
BASE_URL=http://localhost:3000/
ADMIN_EMAIL=jhaey@gmail.com
ADMIN_SETUP_TOKEN=generate-a-long-random-one-time-token

DB_DRIVER=mysql
DB_HOST=your-aiven-host
DB_PORT=your-aiven-port
DB_DATABASE=defaultdb
DB_USERNAME=your-aiven-username
DB_PASSWORD=your-aiven-password
DB_CHARSET=utf8mb4
DB_SSL_CA=app/certs/ca.pem
DB_SSL_VERIFY=1

API_JWT_SECRET=replace-with-at-least-32-random-characters
API_REFRESH_TOKEN_KEY=replace-with-another-32-random-characters
FRONTEND_ORIGIN=http://localhost:3000
