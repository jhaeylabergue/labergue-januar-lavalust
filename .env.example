# Copy this file to .env and update the values below
# cp .env.example .env
# php lava key:generate

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development
BASE_URL=

# Database Configuration (local Laragon development defaults)
# Use local values here for the default app setup.
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mydb
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Leave empty for a local MySQL that does not use TLS.
DB_SSL_CA=
DB_SSL_VERIFY=0
