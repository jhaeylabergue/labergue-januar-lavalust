# Copy this file to .env and update the values below
# cp .env.example .env
# php lava key:generate

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=production
BASE_URL=https://your-domain.onrender.com/

# Database Configuration
DB_DRIVER=mysql
DB_HOST=your-aiven-host
DB_PORT=10726
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=your-aiven-password
DB_CHARSET=utf8mb4
DB_SSL_CA=app/certs/ca.pem
DB_SSL_VERIFY=1
