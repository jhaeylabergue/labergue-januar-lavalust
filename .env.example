# Copy this file to .env and update the values below
# cp .env.example .env
# php lava key:generate

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development
BASE_URL=

# Database Configuration (Aiven MySQL or local)
# Do not commit .env. Use these names on Render as well.
DB_DRIVER=mysql
DB_HOST=
DB_PORT=
DB_DATABASE=mydb
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Path to the Aiven CA certificate downloaded from the service Overview page.
# Leave empty for a local MySQL that does not use TLS.
DB_SSL_CA=app/certs/aiven-ca.pem
DB_SSL_VERIFY=1
